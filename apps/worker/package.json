{
  "name": "@sii/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker do SII (NestJS standalone): filas BullMQ, cargas das fontes, jobs de prazo e indicadores",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/worker/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:integracao": "jest --config test/jest-integracao.config.js --runInBand",
    "cadunico:ficticio": "tsx scripts/cadunico-ficticio.ts",
    "esus:dry-run": "tsx scripts/esus-dry-run.ts",
    "esus:carregar": "tsx scripts/esus-carregar.ts",
    "esus:pec-ficticio": "tsx scripts/esus-pec-ficticio.ts",
    "infrequencia:rodar": "tsx scripts/infrequencia-rodar.ts",
    "prazos:rodar": "tsx scripts/prazos-rodar.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sii/shared": "workspace:*",
    "bullmq": "5.81.5",
    "dotenv": "^18.0.10",
    "ioredis": "^5.11.1",
    "minio": "8.0.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@sii/config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
