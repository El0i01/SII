# SII · variáveis de ambiente. Copie para .env (nunca commitar o .env) e troque as senhas.

NODE_ENV=development
TZ_EXIBICAO=America/Porto_Velho

# API (apps/api)
API_PORTA=3333
WEB_ORIGEM=http://localhost:3000

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
NEXT_PUBLIC_AMBIENTE=homologacao

# Infra local (infra/docker-compose.yml). As portas padrão 5432, 6379, 9000 e 9001 já estão em uso nesta máquina.
POSTGRES_PORTA=5444
POSTGRES_USER=sii
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sii
DATABASE_URL=postgresql://sii:troque-esta-senha@localhost:5444/sii
DATABASE_URL_TESTE=postgresql://sii:troque-esta-senha@localhost:5444/sii_teste

REDIS_PORTA=6390
REDIS_SENHA=troque-esta-senha
REDIS_URL=redis://:troque-esta-senha@localhost:6390/0

MINIO_PORTA=9010
MINIO_CONSOLE_PORTA=9011
MINIO_ROOT_USER=sii
MINIO_ROOT_PASSWORD=troque-esta-senha-com-8+

# Autenticação (P03). JWT_SEGREDO: no mínimo 32 caracteres aleatórios (openssl rand -hex 32).
JWT_SEGREDO=troque-por-32-ou-mais-caracteres-aleatorios
# Validade deslizante do refresh token (cada uso renova). Decisão de 11/11/2026.
REFRESH_HORAS_WEB=12
REFRESH_DIAS_MOBILE=7
# Tentativas de login por IP por minuto (o bloqueio por conta é fixo: 5 falhas → 15 min).
LOGIN_LIMITE_POR_MINUTO=10

# Seed de desenvolvimento (pnpm db:seed): senha única dos usuários fictícios. Nunca em produção.
SEED_SENHA=troque-esta-senha-dev

# Cifragem de CPF, NIS e CNS (P05). Duas chaves DIFERENTES, 32 bytes em hex (openssl rand -hex 32).
# Perder a CHAVE_CIFRA = perder os documentos. Guardar cópia fora do servidor (cofre da CTI).
CHAVE_CIFRA=troque-por-64-caracteres-hex
CHAVE_HMAC=troque-por-outros-64-caracteres-hex

# Pasta do geoportal (shapefiles) para pnpm geo:carregar (P06). Padrão: ~/geoportal_itapua-main(1)/geoportal_itapua-main
# GEOPORTAL_DIR=/caminho/para/geoportal_itapua-main
