# SII · variáveis de ambiente. Copie para .env (nunca commitar o .env).

NODE_ENV=development
TZ_EXIBICAO=America/Porto_Velho

# API (apps/api)
API_PORTA=3333
WEB_ORIGEM=http://localhost:3000

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
NEXT_PUBLIC_AMBIENTE=homologacao

# Infra local (P02). As portas padrão 5432, 6379, 9000 e 9001 já estão em uso nesta máquina.
POSTGRES_PORTA=5444
REDIS_PORTA=6390
MINIO_PORTA=9010
MINIO_CONSOLE_PORTA=9011
